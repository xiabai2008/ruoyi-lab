server {
    listen 19321;
    server_name 127.0.0.1;
    client_max_body_size 100m;

    access_log logs/D1_access.log main;

    # 站点根：真人访问 / 应该看到登录页，而不是 404
    location = / {
        return 302 /portal/;
    }
    location = /portal {
        return 302 /portal/;
    }

    # 带 context-path 的应用入口：原样转发，不做 URI 重写
    location /portal/ {
        proxy_pass http://127.0.0.1:19221;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # ── 二开「内部运维开放接口」网关兼容映射 ─────────────────────────────
    # 二期把内部运维开放接口迁到了 /portal/openapi/**，外部运维平台仍按改版前
    # 的老路径调用。这里只为迁移过的 2 个接口保留网关级路径映射（等价于运维在
    # 网关做 URI rewrite）：只改路径、不做任何鉴权，安全边界全部由后端 Shiro
    # 过滤链负责。漏洞版（lab.mode=vuln）把 /openapi/** 加进 Shiro anon 白名单
    # 后，这两条老路径即被匿名访问；safe 模式下匿名请求仍被 302 到登录页。
    #
    # 2026-11-02（v1.5.6 WP1）调整：原先映射写在 /portal/ **之外**
    # （location = /monitor/job/edit），那是为了迁就「扫描器认不出 /portal」这个
    # 扫描器缺陷。WP1 补上 context-path 识别后，扫描器会正确探
    # /portal/monitor/job/edit——而这条路径当时没有映射，导致 job RCE 从
    # CONFIRMED 回退成 UNKNOWN（探测位置对了，靶场形态没跟上）。
    #
    # 现在映射收敛到 context-path **之内**，与真实二开部署的运维网关形态一致：
    # 外部按 context-path 内的短路径调用，网关 rewrite 到 /openapi/**。
    # 扫描器探 /portal/monitor/job/edit → 网关 rewrite → /portal/openapi/monitor/job/edit。
    #
    # 注意 location 的匹配优先级：前缀匹配 location /portal/ 与下面这些精确/长前缀
    # location 并存时，nginx 用「最长前缀优先」+ 精确匹配优先，因此这些块必须写在
    # /portal/ 之后仍能生效（nginx 会先选最长匹配的 location 块）。
    location = /portal/monitor/job/edit {
        proxy_pass http://127.0.0.1:19221/portal/openapi/monitor/job/edit;
        proxy_redirect http://127.0.0.1:19221/ /;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location ^~ /portal/tool/gen/preview/ {
        proxy_pass http://127.0.0.1:19221/portal/openapi/tool/gen/preview/;
        proxy_redirect http://127.0.0.1:19221/ /;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
